# Local defaults. uvicorn --env-file .env loads this file.
SPARKSCOPE_DATA_DIR=~/.sparkscope
SPARKSCOPE_ORIGINS=http://127.0.0.1:8010,http://localhost:8010,http://127.0.0.1:5178,http://localhost:5178
SPARKSCOPE_SECURE_COOKIE=0
# Team installation: configure an exact HTTPS origin and secure cookies.
# SPARKSCOPE_DATABASE_URL=postgresql+asyncpg://sparkscope:URL_ENCODED_PASSWORD@localhost:5432/sparkscope
# SPARKSCOPE_ORIGINS=https://sparkscope.example.org
# SPARKSCOPE_SECURE_COOKIE=1
# SPARKSCOPE_KEY_FILE=/path/to/protected/master.secret
